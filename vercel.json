{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/api/src/**"
        ],
        "maxDuration": 60
      }
    },
    {
      "src": "backend/api/sync-verified.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/api/src/**"
        ],
        "maxDuration": 300
      }
    }
  ],
  "routes": [
    {
      "src": "/api/internal/property-sync-and-wait/?",
      "dest": "/backend/api/sync-verified.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/index.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "/(.*\\.(png|jpg|jpeg|gif|svg|ico|webp|js|css|woff|woff2|ttf|eot))",
      "dest": "/frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}
